+/******************************************************************************
+ * CommunityKV approximate fixed-point top-8 selection for FlashAttention.
+ *
+ * Each row-mate lane retains six packed candidates. The four sorted lane-local
+ * queues are merged at output without materializing a separate top-8 queue.
+ ******************************************************************************/
+
+#pragma once
+
+#include <cute/tensor.hpp>
+#include <cutlass/numeric_types.h>
+
+namespace flash {
+
+using namespace cute;
+
+template <int kNRows, int K, int B>
+struct WarpSelect;
+
+template <int kNRows>
+struct WarpSelect<kNRows, 8, 16> {
+    static_assert(
+        kNRows == 2,
+        "top-8 selection is specialized for the SM90 d=128 tile");
+
+    static constexpr int K = 8;
+    static constexpr int LocalK = 6;
+    static constexpr int LogicalWarp = 4;
+    static constexpr int IndexBits = 17;
+    static constexpr uint32_t IndexMask =
+        (uint32_t(1) << IndexBits) - 1;
+    static constexpr float ScoreMin = -48.0f;
+    static constexpr float ScoreScale = 256.0f;
+    static constexpr uint32_t Empty = 0;
+
+    uint32_t row0[LocalK];
+    uint32_t row1[LocalK];
+    float scale_log2;
+    float lse0_log2;
+    float lse1_log2;
+
+    template <int R>
+    CUTLASS_DEVICE uint32_t* row() {
+        if constexpr (R == 0) {
+            return row0;
+        } else {
+            return row1;
+        }
+    }
+
+    template <int R>
+    CUTLASS_DEVICE void init_row() {
+        uint32_t* queue = row<R>();
+        #pragma unroll
+        for (int k = 0; k < LocalK; ++k) {
+            queue[k] = Empty;
+        }
+    }
+
+    CUTLASS_DEVICE WarpSelect() {
+        init_row<0>();
+        init_row<1>();
+    }
+
+    CUTLASS_DEVICE static uint16_t score_to_key(float value) {
+        int key = __float2int_rn((value - ScoreMin) * ScoreScale);
+        key = max(0, min(key, 32767));
+        return uint16_t(key);
+    }
+
+    CUTLASS_DEVICE static float key_to_score(uint16_t key) {
+        return float(key) / ScoreScale + ScoreMin;
+    }
+
+    CUTLASS_DEVICE static uint32_t pack(float value, int index) {
+        return (uint32_t(score_to_key(value)) << IndexBits)
+             | (uint32_t(index) & IndexMask);
+    }
+
+    template <int R>
+    CUTLASS_DEVICE void insert(uint32_t candidate) {
+        uint32_t* queue = row<R>();
+        #pragma unroll
+        for (int k = 0; k < LocalK; ++k) {
+            uint32_t const resident = queue[k];
+            queue[k] = max(candidate, resident);
+            candidate = min(candidate, resident);
+        }
+    }
+
+    template <int R, typename ScoresT, typename CoordT>
+    CUTLASS_DEVICE void update_row(
+            ScoresT const& scores,
+            CoordT const& coord,
+            int n_block_offset,
+            int kv_start,
+            float local_max) {
+        constexpr int ncol = decltype(size<1>(scores))::value;
+        uint32_t* queue = row<R>();
+        float const threshold =
+            key_to_score(uint16_t(queue[LocalK - 1] >> IndexBits));
+        bool const skip_local = local_max <= threshold;
+        if (!__all_sync(0xffffffff, skip_local)) {
+            #pragma unroll
+            for (int c = 0; c < ncol; ++c) {
+                float const value = scores(R, c);
+                int const index =
+                    n_block_offset + get<1>(coord(R, c));
+                uint32_t const candidate = pack(value, index);
+                if (index >= kv_start &&
+                    candidate > queue[LocalK - 1]) {
+                    insert<R>(candidate);
+                }
+            }
+        }
+    }
+
+    template <typename ScoresT, typename CoordT, typename TensorMax>
+    CUTLASS_DEVICE void update_with_local_max(
+            ScoresT const& scores,
+            CoordT const& coord,
+            int n_block_offset,
+            int kv_start,
+            TensorMax const& local_max) {
+        update_row<0>(
+            scores, coord, n_block_offset, kv_start, local_max(0));
+        update_row<1>(
+            scores, coord, n_block_offset, kv_start, local_max(1));
+    }
+
+    template <typename TensorLse>
+    CUTLASS_DEVICE void finalize_and_normalize(
+            float softmax_scale_log2,
+            TensorLse const& lse_natural) {
+        scale_log2 = softmax_scale_log2;
+        lse0_log2 = lse_natural(0) * float(M_LOG2E);
+        lse1_log2 = lse_natural(1) * float(M_LOG2E);
+    }
+
+    CUTLASS_DEVICE static unsigned quad_mask() {
+        int const quad = (int(threadIdx.x) & 31) / LogicalWarp;
+        return 0xFu << (quad * LogicalWarp);
+    }
+
+    template <int R, typename CoordT>
+    CUTLASS_DEVICE void write_row(
+            CoordT const& coord_rc,
+            int m_block_row_offset,
+            int bidh,
+            int bidb,
+            int qhead_per_khead,
+            int seqlen_q,
+            int q_skip,
+            float* ptr_val,
+            int32_t* ptr_idx,
+            int64_t stride_batch,
+            int64_t stride_head,
+            int64_t stride_row) {
+        uint32_t const* queue = row<R>();
+        bool const writer = get<1>(coord_rc(R, _0{})) == 0;
+        int const abs_row =
+            m_block_row_offset + get<0>(coord_rc(R, _0{}));
+        int const h_inner =
+            qhead_per_khead == 1 ? 0 : abs_row % qhead_per_khead;
+        int const q_idx =
+            qhead_per_khead == 1 ? abs_row : abs_row / qhead_per_khead;
+        int const abs_h = bidh * qhead_per_khead + h_inner;
+        bool const valid_row = q_idx < seqlen_q && q_idx >= q_skip;
+        int64_t const base = int64_t(bidb) * stride_batch
+                           + int64_t(abs_h) * stride_head
+                           + int64_t(q_idx - q_skip) * stride_row;
+        float const lse_log2 = R == 0 ? lse0_log2 : lse1_log2;
+        unsigned const mask = quad_mask();
+        int const lane = int(threadIdx.x) & (LogicalWarp - 1);
+        uint32_t current = queue[0];
+        int cursor = 0;
+
+        #pragma unroll
+        for (int out = 0; out < K; ++out) {
+            uint32_t best = current;
+            best = max(
+                best,
+                __shfl_xor_sync(mask, best, 1, LogicalWarp));
+            best = max(
+                best,
+                __shfl_xor_sync(mask, best, 2, LogicalWarp));
+            unsigned const winners =
+                __ballot_sync(mask, current == best);
+            int const winner_lane =
+                (__ffs(winners) - 1) & (LogicalWarp - 1);
+
+            if (writer && valid_row) {
+                uint16_t const key = uint16_t(best >> IndexBits);
+                ptr_val[base + out] =
+                    exp2f(key_to_score(key) * scale_log2 - lse_log2);
+                ptr_idx[base + out] = int32_t(best & IndexMask);
+            }
+
+            bool const advance = lane == winner_lane;
+            int const next_cursor = cursor + int(advance);
+            uint32_t next = Empty;
+            #pragma unroll
+            for (int slot = 1; slot < LocalK; ++slot) {
+                next = next_cursor == slot ? queue[slot] : next;
+            }
+            current = advance ? next : current;
+            cursor = next_cursor;
+        }
+    }
+
+    template <typename CoordT>
+    CUTLASS_DEVICE void write_to_gmem(
+            CoordT const& coord_rc,
+            int m_block_row_offset,
+            int bidh,
+            int bidb,
+            int qhead_per_khead,
+            int seqlen_q,
+            int q_skip,
+            float* ptr_val,
+            int32_t* ptr_idx,
+            int64_t stride_batch,
+            int64_t stride_head,
+            int64_t stride_row) {
+        if (ptr_val == nullptr || ptr_idx == nullptr) {
+            return;
+        }
+        write_row<0>(
+            coord_rc, m_block_row_offset, bidh, bidb,
+            qhead_per_khead, seqlen_q, q_skip,
+            ptr_val, ptr_idx,
+            stride_batch, stride_head, stride_row);
+        write_row<1>(
+            coord_rc, m_block_row_offset, bidh, bidb,
+            qhead_per_khead, seqlen_q, q_skip,
+            ptr_val, ptr_idx,
+            stride_batch, stride_head, stride_row);
+    }
+};
+
+}  // namespace flash
